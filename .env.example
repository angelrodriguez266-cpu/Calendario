# ==============================================================================
# MARÍA Y ÁNGEL — UNA NAVIDAD JUNTOS (Variables de Entorno del Servidor)
# ==============================================================================
# Copia este archivo como `.env.local` y configura tus valores reales.
# NUNCA subas `.env.local` al repositorio ni expongas claves secretas en el cliente.

# ------------------------------------------------------------------------------
# 1. ACCESO PRIVADO DE MARÍA (Página pública)
# ------------------------------------------------------------------------------
# Genera el hash ejecutando: npm run hash-password -- "tu-clave-especial"
CALENDAR_PASSWORD_HASH=
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=604800

# ------------------------------------------------------------------------------
# 2. SUPABASE — PANEL DE ADMINISTRACIÓN (/admin) Y CONTENIDOS PRIVADOS
# ------------------------------------------------------------------------------
# URL de tu proyecto Supabase (ej: https://tu-proyecto.supabase.co)
SUPABASE_URL=

# Clave publicable (anon / publishable key) usada por el servidor para Auth
SUPABASE_PUBLISHABLE_KEY=

# Clave privilegiada de servidor (NUNCA exponer en frontend ni en variables públicas)
# Utilizada exclusivamente en el servidor Node.js para emitir URLs firmadas
# temporales a María (solo días desbloqueados) y verificar permisos de administrador.
SUPABASE_SERVICE_ROLE_KEY=

# Lista de correos electrónicos autorizados para /admin (separados por coma).
# Además, el usuario DEBE estar registrado en la tabla `public.admin_users` en Supabase.
ADMIN_ALLOWED_EMAILS=

# Secreto independiente para firmar la cookie HttpOnly del administrador (opcional;
# si se omite, deriva de SESSION_SECRET)
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------------------
# 3. SOLO DESARROLLO LOCAL (nunca habilitar en producción)
# ------------------------------------------------------------------------------
# CALENDAR_DEV_BOGOTA_ISO=2026-12-03T20:15:00-05:00
# CALENDAR_DEV_BOGOTA_LIVE_TICK=true
